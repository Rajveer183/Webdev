# Copy to .env and fill in. Never commit .env.

# --- Environment ---
APP_ENV=production            # development | production | test
LOG_LEVEL=INFO

# --- Database (docker compose builds DATABASE_URL from these) ---
POSTGRES_DB=statsphere
POSTGRES_USER=statsphere
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# For running the backend outside Docker, set DATABASE_URL directly, e.g.
# DATABASE_URL=postgresql+psycopg://statsphere:password@localhost:5432/statsphere
# Leave unset for local development to use SQLite (backend/statsphere.db).

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-value-of-at-least-32-characters
JWT_EXPIRE_MINUTES=120
# First admin user, created on startup if it does not exist. Remove ADMIN_PASSWORD afterwards
# (or manage admins with: python -m app.cli create-admin <username>).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Browser origins allowed to call the API (comma-separated) ---
CORS_ORIGINS=http://localhost:8090

# --- Public site ---
SITE_URL=                     # e.g. https://www.your-domain.com (canonical links + sitemap)
VITE_BOOKING_URL=             # optional https:// scheduling link (can also be set in Admin → Settings)
HTTP_PORT=8090

# --- Form protection ---
ENQUIRY_RATE_LIMIT=5
ENQUIRY_RATE_WINDOW_SECONDS=600
MIN_FORM_FILL_SECONDS=3

# --- E-mail notifications for new enquiries ---
# Every submitted form (consulting, course, corporate training, contact) is e-mailed to NOTIFY_EMAIL.
# This address is private: it is never shown on the website or returned by the public API.
# Default inbox: rajveersinghrathorer584@gmail.com (set NOTIFY_EMAIL to change it).
# Gmail: enable 2-Step Verification on the account, create an App Password
# (Google Account → Security → App passwords) and use it as SMTP_PASSWORD.
NOTIFY_EMAIL=rajveersinghrathorer584@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=rajveersinghrathorer584@gmail.com
SMTP_PASSWORD=                # Gmail App Password (16 characters). Leave empty to disable sending.
SMTP_FROM=                    # optional; defaults to SMTP_USERNAME
# Alternative to SMTP (needed on hosts that block SMTP ports, e.g. Render free tier):
# free Brevo account → verify SMTP_FROM as a sender → create an API key. When set, SMTP_* login is not used.
BREVO_API_KEY=

# --- Startup behaviour ---
AUTO_MIGRATE=true
SEED_ON_STARTUP=true
MAX_UPLOAD_MB=25
